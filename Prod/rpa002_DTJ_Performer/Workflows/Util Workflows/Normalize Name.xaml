    <ui:InvokeCode ContinueOnError="{x:Null}" Code="' Init&#xA;If String.IsNullOrWhiteSpace(in_str_originalName) Then Return&#xA;Dim str_base As String = in_str_originalName.Trim()&#xA;Dim io_list_results As New List(Of String)&#xA;Dim hs_uniques As New HashSet(Of String)(StringComparer.OrdinalIgnoreCase)&#xA;&#xA;' Helpers&#xA;Dim AddUnique As Action(Of String) =&#xA;    Sub(v As String)&#xA;        If Not String.IsNullOrWhiteSpace(v) Then&#xA;            Dim s As String = v.Trim()&#xA;            If hs_uniques.Add(s) Then io_list_results.Add(s)&#xA;        End If&#xA;    End Sub&#xA;&#xA;Dim NormalizeToken As Func(Of String, String) =&#xA;    Function(x As String) As String&#xA;        If String.IsNullOrEmpty(x) Then&#xA;            Return &quot;&quot;&#xA;        Else&#xA;            Dim letters As Char() = x.ToLowerInvariant().Where(Function(ch As Char) Char.IsLetter(ch)).ToArray()&#xA;            Return New String(letters).Replace(&quot;ä&quot;, &quot;a&quot;).Replace(&quot;ö&quot;, &quot;o&quot;).Replace(&quot;ü&quot;, &quot;u&quot;)&#xA;        End If&#xA;    End Function&#xA;&#xA;Dim ToAscii As Func(Of String, String) =&#xA;    Function(s As String) As String&#xA;        Return s.Replace(&quot;ä&quot;, &quot;ae&quot;).Replace(&quot;ö&quot;, &quot;oe&quot;).Replace(&quot;ü&quot;, &quot;ue&quot;).Replace(&quot;Ä&quot;, &quot;Ae&quot;).Replace(&quot;Ö&quot;, &quot;Oe&quot;).Replace(&quot;Ü&quot;, &quot;Ue&quot;)&#xA;    End Function&#xA;&#xA;Dim ToVowel As Func(Of String, String) =&#xA;    Function(s As String) As String&#xA;        Return s.Replace(&quot;ae&quot;, &quot;ä&quot;).Replace(&quot;oe&quot;, &quot;ö&quot;).Replace(&quot;ue&quot;, &quot;ü&quot;).Replace(&quot;Ae&quot;, &quot;Ä&quot;).Replace(&quot;Oe&quot;, &quot;Ö&quot;).Replace(&quot;Ue&quot;, &quot;Ü&quot;)&#xA;    End Function&#xA;&#xA;' Blocked token set&#xA;Dim regx As New System.Text.RegularExpressions.Regex(&quot;[\s\-\.\(\),]+&quot;, System.Text.RegularExpressions.RegexOptions.Compiled)&#xA;Dim blocked_full As IEnumerable(Of String) = in_list_prefixTitleTokens.Select(Function(t As String) NormalizeToken(t))&#xA;Dim blocked_parts As IEnumerable(Of String) =&#xA;    in_list_prefixTitleTokens.SelectMany(Function(t As String) As IEnumerable(Of String)&#xA;                                             Return regx.Split(t)&#xA;                                         End Function).Select(Function(p As String) NormalizeToken(p)).Where(Function(p As String) p &lt;&gt; &quot;&quot;)&#xA;Dim hs_blockedTokens As New HashSet(Of String)(blocked_full.Concat(blocked_parts), StringComparer.OrdinalIgnoreCase)&#xA;&#xA;' Add original&#xA;AddUnique(str_base)&#xA;&#xA;' Clean text&#xA;Dim list_tokens As List(Of String) =&#xA;    regx.Split(str_base).Where(Function(t As String)&#xA;                                   Dim k As String = NormalizeToken(t)&#xA;                                   Return k.Length &gt; 1 AndAlso Not hs_blockedTokens.Contains(k)&#xA;                               End Function).ToList()&#xA;&#xA;If list_tokens.Count = 0 Then&#xA;    io_list_normalizedNames = io_list_results&#xA;    Return&#xA;End If&#xA;&#xA;Dim str_clean As String = String.Join(&quot; &quot;, list_tokens)&#xA;AddUnique(str_clean)&#xA;&#xA;' Variants&#xA;If str_clean.IndexOfAny({&quot;ä&quot;c, &quot;ö&quot;c, &quot;ü&quot;c}) &gt;= 0 Then AddUnique(ToAscii(str_clean))&#xA;If str_clean.Contains(&quot;ae&quot;) OrElse str_clean.Contains(&quot;oe&quot;) OrElse str_clean.Contains(&quot;ue&quot;) Then AddUnique(ToVowel(str_clean))&#xA;&#xA;If str_clean.Contains(&quot; &quot;c) Then&#xA;    AddUnique(str_clean.Replace(&quot; &quot;, &quot;-&quot;))&#xA;    AddUnique(str_clean.Split(&quot; &quot;c)(0))&#xA;ElseIf str_clean.Contains(&quot;-&quot;c) Then&#xA;    AddUnique(str_clean.Replace(&quot;-&quot;, &quot; &quot;))&#xA;    AddUnique(str_clean.Split(&quot;-&quot;c)(0))&#xA;End If&#xA;&#xA;' Last token&#xA;Dim last As String = list_tokens.Last()&#xA;AddUnique(last)&#xA;If last.Contains(&qu
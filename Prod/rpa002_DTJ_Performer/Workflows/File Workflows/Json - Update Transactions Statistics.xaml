    <ui:InvokeCode ContinueOnError="{x:Null}" Code="Dim dict_refTxns As New List(Of Dictionary(Of String, Object))&#xD;&#xA;&#xD;&#xA;For Each kvp In in_dict_txns&#xD;&#xA;    Dim val = kvp.Value&#xD;&#xA;    If TypeOf val Is JObject Then&#xD;&#xA;        dict_refTxns.Add(CType(val, JObject).ToObject(Of Dictionary(Of String, Object))())&#xD;&#xA;    ElseIf TypeOf val Is Dictionary(Of String, Object) Then&#xD;&#xA;        dict_refTxns.Add(DirectCast(val, Dictionary(Of String, Object)))&#xD;&#xA;    End If&#xD;&#xA;Next&#xD;&#xA;&#xD;&#xA;io_Config(&quot;CountTotal&quot;) = dict_refTxns.Count&#xD;&#xA;io_Config(&quot;CountSkipped&quot;) = dict_refTxns.Where(Function(v) v.ContainsKey(&quot;Status&quot;) AndAlso {&quot;Neu&quot;, &quot;Nicht Hochgeladen&quot;}.Contains(v(&quot;Status&quot;).ToString)).Count()&#xD;&#xA;io_Config(&quot;CountToProcess&quot;)  = dict_refTxns.Where(Function(v) v.ContainsKey(&quot;Status&quot;) AndAlso v(&quot;Status&quot;).ToString = &quot;Hochgeladen&quot;).Count()&#xD;&#xA;io_Config(&quot;CountSuccess&quot;)= dict_refTxns.Where(Function(v) v.ContainsKey(&quot;Status&quot;) AndAlso v(&quot;Status&quot;).ToString = &quot;Erfolgreich&quot;).Count()&#xD;&#xA;io_Config(&quot;CountBE&quot;) = dict_refTxns.Where(Function(v) v.ContainsKey(&quot;Status&quot;) AndAlso v(&quot;Status&quot;).ToString = &quot;Ausgesteuert&quot;).Count()&#xD;&#xA;io_Config(&quot;CountSE&quot;) = dict_refTxns.Where(Function(v) v.ContainsKey(&quot;Status&quot;) AndAlso v(&quot;Status&quot;).ToString = &quot;Systemfehler&quot;).Count()&#xD;&#xA;&#xD;&#xA;If in_bool_shouldSumDuration Then&#xD;&#xA;    Dim ts_totalDuration As New TimeSpan(0)&#xD;&#xA;    For Each dict_refTxnsItem As Dictionary(Of String, Object) In dict_refTxns&#xD;&#xA;        If dict_refTxnsItem.ContainsKey(&quot;Dauer&quot;) AndAlso dict_refTxnsItem(&quot;Dauer&quot;) IsNot Nothing Then&#xD;&#xA;            Dim str_refTxnsItemDuration As String = dict_refTxnsItem(&quot;Dauer&quot;).ToString.Trim&#xD;&#xA;
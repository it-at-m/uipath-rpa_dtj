    <ui:InvokeCode ContinueOnError="{x:Null}" Code="' Normalize to List(Of Dictionary)&#xD;&#xA;Dim dict_refTxns As New List(Of Dictionary(Of String, Object))&#xD;&#xA;For Each kvp In in_dict_txns&#xD;&#xA;    Dim val = kvp.Value&#xD;&#xA;    If TypeOf val Is JObject Then&#xD;&#xA;        dict_refTxns.Add(DirectCast(val, JObject).ToObject(Of Dictionary(Of String, Object))())&#xD;&#xA;    ElseIf TypeOf val Is Dictionary(Of String, Object) Then&#xD;&#xA;        dict_refTxns.Add(DirectCast(val, Dictionary(Of String, Object)))&#xD;&#xA;    End If&#xD;&#xA;Next&#xD;&#xA;&#xD;&#xA;Dim int_countSkipped, int_countOpen, int_countSuccess, int_countBE, int_countSE, int_countSendReminder As Integer&#xD;&#xA;Dim dbl_sumTotalDurationSeconds As Double = 0.0R&#xD;&#xA;&#xD;&#xA;For Each dict_txnsItem In dict_refTxns&#xD;&#xA;    ' Get Status&#xD;&#xA;    Dim str_status As String = If(dict_txnsItem.ContainsKey(&quot;Status&quot;) AndAlso dict_txnsItem(&quot;Status&quot;) IsNot Nothing, dict_txnsItem(&quot;Status&quot;).ToString, Nothing)&#xD;&#xA;&#xD;&#xA;&#x9; ' Count Status&#xD;&#xA;    Select Case str_status&#xD;&#xA;        Case &quot;Neu&quot;, &quot;Nicht Hochgeladen&quot;: int_countSkipped += 1&#xD;&#xA;        Case &quot;Hochgeladen&quot;: int_countOpen += 1&#xD;&#xA;        Case &quot;Erfolgreich&quot;: int_countSuccess += 1&#xD;&#xA;        Case &quot;Ausgesteuert&quot;: int_countBE += 1&#xD;&#xA;        Case &quot;Systemfehler&quot;: int_countSE += 1&#xD;&#xA;    End Select&#xD;&#xA;&#x9;&#xD;&#xA;&#x9; ' Sum Duration if should&#xD;&#xA;&#x9;If in_bool_shouldSumDuration AndAlso dict_txnsItem.ContainsKey(&quot;Dauer&quot;) AndAlso dict_txnsItem(&quot;Dauer&quot;) IsNot Nothing Then&#xD;&#xA;    &#x9;dbl_sumTotalDurationSeconds += Convert.ToDouble(dict_txnsItem(&quot;Dauer&quot;))&#xD;&#xA;&#x9;End If&#xD;&#xA;&#x9;&#xD;&#xA;Next&#xD;&#xA;&#xD;&#xA;' Output&#xD;&#xA;io_dict_statistics(&quot;CountTotal&quot;) = dict_refTxns.Count&#xD;&#xA;io_dict_statistics(&quot;CountTotalProcessed&quot;) = dict_refTxns.Count - (int_countOpen + int_countSkipped)&#xD;&#xA;io_dict_statistics(&quot;SumTotalDurationSeconds&quot;) = dbl_sumTotalDurationSeconds&#xD;&#xA;io_dict_statistics(&quot;CountSkipped&quot;) = int_countSkipped&#xD;&#xA;io_dict_statistics(&quot;CountOpen&quot;) = int_countOpen&#xD;&#xA;io_dict_statistics(&quot;CountSuccess&quot;) = int_countSuccess&#xD;&#xA;io_dict_statistics(&quot;CountBE&quot;) = int_countBE&#xD;&#xA;io_dict_statistics(&quot;CountSE&quot;) = int_countSE" DisplayName="Invoke Code" sap:VirtualizedContainerService.HintSize="416,188" sap2010:WorkflowViewState.IdRef="InvokeCode_1">
